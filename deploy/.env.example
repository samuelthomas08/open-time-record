# Copy this file to .env and fill in real values before running `docker compose up -d`.

# --- Database ---
POSTGRES_DB=otr
POSTGRES_USER=otr
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_KEY=change-me
JWT_ISSUER=otr-backend
JWT_AUDIENCE=otr-frontend

# --- Domain / TLS ---
# Leave as-is for local access over plain HTTP on http://localhost.
# Set to your real domain (no scheme, e.g. otr.example.com) and point its DNS at this
# server to get automatic HTTPS via Let's Encrypt.
DOMAIN=http://localhost

# --- Version ---
# Pin a specific release (matches a GitHub Release tag, e.g. v1.4.0), or leave as latest.
OTR_VERSION=latest
